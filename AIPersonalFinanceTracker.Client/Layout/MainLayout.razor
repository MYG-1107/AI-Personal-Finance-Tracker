@inherits LayoutComponentBase
@inject FinanceApiService ApiService
@inject CurrencyService Currency
@inject IJSRuntime JS

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 px-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">AI Personal Finance Tracker</a>
            <div class="navbar-nav">
                <a class="nav-link text-white fw-semibold me-3" href="/">Dashboard</a>
                <a class="nav-link text-white fw-semibold" href="/transactions">Transactions & Input Form</a>
                <a class="nav-link text-white fw-semibold ms-3" href="/profile">Profile</a>
                <a class="nav-link text-white fw-semibold ms-3" href="/goals">Goals</a>
                <a class="nav-link text-white fw-semibold ms-3" href="/advisor">AI Advisor</a>
                <button class="btn btn-sm btn-outline-light ms-3" @onclick="ToggleTheme">@((darkMode) ? "Light mode" : "Dark mode")</button>
            </div>
        </div>
    </nav>
    <main class="container-fluid px-4">
        @Body
    </main>
</div>

@code {
    private bool darkMode;

    private void ToggleTheme()
    {
        darkMode = !darkMode;
        JS.InvokeVoidAsync("setTheme", darkMode ? "dark" : "light");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ApiService.GetProfileAsync();
            if (profile != null)
                Currency.SetCurrency(profile.CurrencyCode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load saved profile preferences: {ex.Message}");
        }
    }
}
