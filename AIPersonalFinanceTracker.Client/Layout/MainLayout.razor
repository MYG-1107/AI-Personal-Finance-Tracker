@inherits LayoutComponentBase
@inject FinanceApiService ApiService
@inject CurrencyService Currency
@inject IJSRuntime JS

<div class="page">
    <nav class="app-header navbar navbar-expand-lg navbar-dark px-3">
        <div class="container-fluid">
            <a class="navbar-brand app-brand" href="/">
                <span class="brand-mark">AI</span>
                <span><strong>Finance</strong><small>Personal intelligence</small></span>
            </a>
            <div class="navbar-nav app-nav">
                <a class="nav-link" href="/">Overview</a>
                <a class="nav-link" href="/transactions">Transactions</a>
                <a class="nav-link" href="/profile">Profile</a>
                <a class="nav-link" href="/goals">Goals</a>
                <a class="nav-link" href="/advisor">AI Advisor</a>
                <button class="theme-toggle" @onclick="ToggleTheme" aria-label="Toggle color theme">
                    <span aria-hidden="true">☼</span> @((darkMode) ? "Light" : "Dark")
                </button>
            </div>
        </div>
    </nav>
    <main class="app-main container-fluid">
        @Body
    </main>
</div>

@code {
    private bool darkMode;

    private void ToggleTheme()
    {
        darkMode = !darkMode;
        JS.InvokeVoidAsync("setTheme", darkMode ? "dark" : "light");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await ApiService.GetProfileAsync();
            if (profile != null)
                Currency.SetCurrency(profile.CurrencyCode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load saved profile preferences: {ex.Message}");
        }
    }
}
