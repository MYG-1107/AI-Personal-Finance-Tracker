@inherits LayoutComponentBase
@inject FinanceApiService ApiService
@inject CurrencyService Currency
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page">
    <nav class="app-header navbar navbar-expand-lg navbar-dark px-3">
        <div class="container-fluid">
            <a class="navbar-brand app-brand" href="/">
                <img class="brand-logo" src="logo.svg" alt="AI Personal Finance Tracker logo" />
                <span><strong>Finance</strong><small>Personal intelligence</small></span>
            </a>
            <div class="navbar-nav app-nav">
                @if (isAuthenticated)
                {
                    <a class="nav-link" href="/">Overview</a>
                    <a class="nav-link" href="/transactions">Transactions</a>
                    <a class="nav-link" href="/profile">Profile</a>
                    <a class="nav-link" href="/goals">Goals</a>
                    <a class="nav-link" href="/advisor">AI Advisor</a>
                    <span class="nav-link signed-in-status" aria-label="Signed in">Signed in</span>
                    <button class="logout-button" @onclick="SignOut">Log out</button>
                }
                else
                {
                    <a class="nav-link" href="/login">Sign in</a>
                    <a class="nav-link" href="/register">Create account</a>
                }
                <button class="theme-toggle" @onclick="ToggleTheme" aria-label="Toggle color theme">
                    <span aria-hidden="true">☼</span> @((darkMode) ? "Light" : "Dark")
                </button>
            </div>
        </div>
    </nav>
    <main class="app-main container-fluid">
        @Body
    </main>
</div>

@code {
    private bool darkMode;
    private bool isAuthenticated;

    private void ToggleTheme()
    {
        darkMode = !darkMode;
        JS.InvokeVoidAsync("setTheme", darkMode ? "dark" : "light");
        JS.InvokeVoidAsync("localStorage.setItem", "finance.theme", darkMode ? "dark" : "light");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var path = new Uri(Navigation.Uri).AbsolutePath;
            await JS.InvokeVoidAsync("localStorage.removeItem", "finance.user");
            var signedIn = await JS.InvokeAsync<string?>("sessionStorage.getItem", "finance.user");
            isAuthenticated = !string.IsNullOrWhiteSpace(signedIn);
            var savedTheme = await JS.InvokeAsync<string?>("localStorage.getItem", "finance.theme");
            darkMode = savedTheme == "dark";
            await JS.InvokeVoidAsync("setTheme", darkMode ? "dark" : "light");
            if (!isAuthenticated && path is not "/login" and not "/register")
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var profile = await ApiService.GetProfileAsync();
            if (profile != null)
                Currency.SetCurrency(profile.CurrencyCode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load saved profile preferences: {ex.Message}");
        }
    }

    private async Task SignOut()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "finance.user");
        await JS.InvokeVoidAsync("localStorage.removeItem", "finance.user");
        isAuthenticated = false;
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
