@page "/"
@using AIPersonalFinanceTracker.Shared.Models
@using AIPersonalFinanceTracker.Client.Services
@inject FinanceApiService ApiService
@inject IJSRuntime JS

<PageTitle>Dashboard - AI Personal Finance Tracker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Financial Summary Dashboard</h2>
    <button class="btn btn-outline-primary btn-sm" @onclick="LoadDashboard">Refresh</button>
</div>

<!-- Budget Exceeded / Warning Alerts -->
@if (budgetAlerts.Any())
{
    <div class="mb-4">
        @foreach (var alert in budgetAlerts)
        {
            <div class="alert @alert.AlertClass alert-dismissible fade show shadow-sm" role="alert">
                <strong>@alert.Title:</strong> @alert.Message
            </div>
        }
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white p-3 border-0 shadow-sm">
            <span class="text-uppercase small">Total Net Balance</span>
            <h3 class="fw-bold mb-0">$@netBalance.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white p-3 border-0 shadow-sm">
            <span class="text-uppercase small">Total Income</span>
            <h3 class="fw-bold mb-0">+$@totalIncome.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white p-3 border-0 shadow-sm">
            <span class="text-uppercase small">Total Expenses</span>
            <h3 class="fw-bold mb-0">-$@totalExpenses.ToString("N2")</h3>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Category Budget Limits & Progress Bars -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h5 class="mb-3">Expense Budget Limits</h5>
            @if (!categorySpend.Any())
            {
                <p class="text-muted">No expense categories available.</p>
            }
            else
            {
                @foreach (var cat in categorySpend)
                {
                    var percentage = cat.Limit > 0 ? Math.Min(100, (double)(cat.Spent / cat.Limit * 100)) : 0;
                    var barColor = percentage >= 100 ? "bg-danger" : (percentage >= 80 ? "bg-warning" : "bg-info");

                    <div class="mb-3">
                        <div class="d-flex justify-content-between fw-semibold small mb-1">
                            <span>@cat.Name</span>
                            <span>$@cat.Spent.ToString("N2") / $@cat.Limit.ToString("N2")</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar @barColor" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- AI Insights Summary -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h5 class="mb-3">Period AI Insights</h5>
            <div class="mb-3 p-3 bg-light rounded">
                <span class="text-muted small">Transactions Recorded</span>
                <h4 class="fw-bold text-dark mb-0">@totalTransactions</h4>
            </div>
            <div class="mb-3 p-3 bg-light rounded">
                <span class="text-muted small">AI Auto-Categorized</span>
                <h4 class="fw-bold text-success mb-0">@autoCategorizedCount</h4>
            </div>
            <div class="p-3 bg-light rounded">
                <span class="text-muted small">Top Expense Category</span>
                <h4 class="fw-bold text-danger mb-0">@(topCategory ?? "N/A")</h4>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal netBalance = 0;
    private decimal totalIncome = 0;
    private decimal totalExpenses = 0;
    private int totalTransactions = 0;
    private int autoCategorizedCount = 0;
    private string? topCategory;

    private List<CategoryBudgetModel> categorySpend = new();
    private List<BudgetAlertModel> budgetAlerts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        var transactions = await ApiService.GetTransactionsAsync();
        var categories = await ApiService.GetCategoriesAsync();

        totalTransactions = transactions.Count;
        autoCategorizedCount = transactions.Count(t => t.IsAutoCategorized);

        totalIncome = transactions
            .Where(t => t.Category?.Type == "Income")
            .Sum(t => t.Amount);

        totalExpenses = transactions
            .Where(t => t.Category == null || t.Category.Type == "Expense")
            .Sum(t => t.Amount);

        netBalance = totalIncome - totalExpenses;

        // Group expense spending by category
        categorySpend = categories
            .Where(c => c.Type == "Expense")
            .Select(c => new CategoryBudgetModel
            {
                Name = c.Name,
                Limit = c.MonthlyBudgetLimit,
                Spent = transactions.Where(t => t.CategoryId == c.Id).Sum(t => t.Amount)
            })
            .ToList();

        var highest = categorySpend.OrderByDescending(c => c.Spent).FirstOrDefault();
        topCategory = highest?.Spent > 0 ? highest.Name : "None";

        // Compute budget alerts
        budgetAlerts.Clear();
        foreach (var item in categorySpend)
        {
            if (item.Limit > 0)
            {
                if (item.Spent >= item.Limit)
                {
                    budgetAlerts.Add(new BudgetAlertModel
                    {
                        Title = "⚠️ Budget Limit Exceeded",
                        Message = $"Spending in '{item.Name}' has exceeded your budget of ${item.Limit:N2} (Current: ${item.Spent:N2}).",
                        AlertClass = "alert-danger"
                    });
                }
                else if (item.Spent >= item.Limit * 0.8m)
                {
                    budgetAlerts.Add(new BudgetAlertModel
                    {
                        Title = "⚡ Nearing Budget Limit",
                        Message = $"Spending in '{item.Name}' is at {item.Spent / item.Limit * 100:F0}% of your ${item.Limit:N2} limit.",
                        AlertClass = "alert-warning"
                    });
                }
            }
        }
    }

    public class CategoryBudgetModel
    {
        public string Name { get; set; } = string.Empty;
        public decimal Limit { get; set; }
        public decimal Spent { get; set; }
    }

    public class BudgetAlertModel
    {
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string AlertClass { get; set; } = string.Empty;
    }
}
