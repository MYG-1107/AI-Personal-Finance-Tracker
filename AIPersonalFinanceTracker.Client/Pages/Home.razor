@page "/"
@using AIPersonalFinanceTracker.Shared.Models
@using AIPersonalFinanceTracker.Client.Services
@inject FinanceApiService ApiService
@inject IJSRuntime JS

<PageTitle>Dashboard - AI Personal Finance Tracker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Financial Summary Dashboard</h2>
    <div class="d-flex align-items-center gap-2">
        <label class="fw-bold me-1">Filter:</label>
        <select class="form-select form-select-sm w-auto" @bind="selectedFilter" @bind:after="OnFilterChanged">
            <option value="All">All Time</option>
            <option value="ThisMonth">This Month</option>
            <option value="LastMonth">Last Month</option>
        </select>
        <button class="btn btn-outline-primary btn-sm ms-2" @onclick="LoadData">
            Refresh
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-3">
                    <h6 class="card-title text-white-50 text-uppercase fw-bold">Total Net Balance</h6>
                    <h3 class="mb-0">$@netBalance.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body p-3">
                    <h6 class="card-title text-white-50 text-uppercase fw-bold">Total Income</h6>
                    <h3 class="mb-0">+$@totalIncome.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body p-3">
                    <h6 class="card-title text-white-50 text-uppercase fw-bold">Total Expenses</h6>
                    <h3 class="mb-0">-$@totalExpenses.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Budget Analytics -->
    <div class="row g-4 mb-4">
        <!-- Visual Expense Chart -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="mb-3 text-center">Expense Breakdown</h5>
                @if (!categorySpending.Any(c => c.Spent > 0))
                {
                    <p class="text-muted text-center my-auto">No expense data for this period.</p>
                }
                else
                {
                    <div style="max-width: 320px; margin: 0 auto;">
                        <canvas id="expenseChart"></canvas>
                    </div>
                }
            </div>
        </div>

        <!-- Expense Budget Limits -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="mb-3">Expense Budget Limits</h5>
                @if (!categorySpending.Any())
                {
                    <p class="text-muted">No expense categories recorded.</p>
                }
                else
                {
                    @foreach (var item in categorySpending)
                    {
                        var percentage = item.BudgetLimit > 0 ? Math.Min(100, (item.Spent / item.BudgetLimit) * 100) : 0;
                        var progressClass = percentage > 90 ? "bg-danger" : percentage > 70 ? "bg-warning" : "bg-info";

                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold">@item.CategoryName</span>
                                <small class="text-muted">$@item.Spent.ToString("F2") / $@item.BudgetLimit.ToString("F2")</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @progressClass" role="progressbar" style="width: @percentage.ToString("F0")%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- AI Insights -->
    <div class="card border-0 shadow-sm p-4">
        <h5 class="mb-3">Period AI Insights</h5>
        <div class="row text-center">
            <div class="col-md-4">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">Transactions Recorded</small>
                    <span class="fs-4 fw-bold">@filteredTransactions.Count</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">AI Auto-Categorized</small>
                    <span class="fs-4 fw-bold text-success">@filteredTransactions.Count(t => t.IsAutoCategorized)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">Top Expense Category</small>
                    <span class="fs-4 fw-bold text-danger">@(topExpenseCategory ?? "N/A")</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction> allTransactions = new();
    private List<Transaction> filteredTransactions = new();
    private List<Category> categories = new();
    private List<CategorySpendingModel> categorySpending = new();
    private bool isLoading = true;
    private string selectedFilter = "All";

    private decimal totalIncome => filteredTransactions.Where(t => t.Category?.Type == "Income").Sum(t => t.Amount);
    private decimal totalExpenses => filteredTransactions.Where(t => t.Category?.Type == "Expense").Sum(t => t.Amount);
    private decimal netBalance => totalIncome - totalExpenses;
    private string? topExpenseCategory;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = await ApiService.GetCategoriesAsync();
            allTransactions = await ApiService.GetTransactionsAsync();
            ApplyFilter();
        }
        catch
        {
            // Fallback gracefully
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFilterChanged()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var now = DateTime.UtcNow;
        if (selectedFilter == "ThisMonth")
        {
            filteredTransactions = allTransactions.Where(t => t.Date.Month == now.Month && t.Date.Year == now.Year).ToList();
        }
        else if (selectedFilter == "LastMonth")
        {
            var lastMonth = now.AddMonths(-1);
            filteredTransactions = allTransactions.Where(t => t.Date.Month == lastMonth.Month && t.Date.Year == lastMonth.Year).ToList();
        }
        else
        {
            filteredTransactions = allTransactions.ToList();
        }

        CalculateAnalytics();
    }

    private void CalculateAnalytics()
    {
        var expenseCategories = categories.Where(c => c.Type == "Expense").ToList();

        categorySpending = expenseCategories.Select(c => new CategorySpendingModel
        {
            CategoryName = c.Name,
            Spent = filteredTransactions.Where(t => t.CategoryId == c.Id).Sum(t => t.Amount),
            BudgetLimit = c.MonthlyBudgetLimit
        }).ToList();

        topExpenseCategory = categorySpending
            .OrderByDescending(c => c.Spent)
            .FirstOrDefault(c => c.Spent > 0)?.CategoryName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && categorySpending.Any(c => c.Spent > 0))
        {
            try
            {
                var activeExpenses = categorySpending.Where(c => c.Spent > 0).ToList();
                var labels = activeExpenses.Select(c => c.CategoryName).ToArray();
                var data = activeExpenses.Select(c => (double)c.Spent).ToArray();

                await JS.InvokeVoidAsync("financeHelpers.renderChart", "expenseChart", labels, data);
            }
            catch
            {
                // Prevent JS interop failure from breaking WASM execution
            }
        }
    }

    private class CategorySpendingModel
    {
        public string CategoryName { get; set; } = string.Empty;
        public decimal Spent { get; set; }
        public decimal BudgetLimit { get; set; }
    }
}
