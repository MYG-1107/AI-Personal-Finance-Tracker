@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject CurrencyService Currency

<PageTitle>Financial Dashboard</PageTitle>

<div class="page-intro">
    <div>
        <p class="eyebrow">YOUR FINANCIAL COMMAND CENTER</p>
        <h1>Financial summary</h1>
        <p class="page-subtitle">A clear view of your money, momentum, and monthly limits.</p>
    </div>
    <a class="btn btn-primary" href="/transactions">+ Add transaction</a>
    <a class="btn btn-outline-primary" href="/advisor">Ask AI Advisor</a>
</div>

<div class="row g-3 mb-4 metric-grid">
        <div class="col-md-4">
            <div class="metric-card metric-card-primary">
                <div class="metric-label">Total balance</div>
                <div class="metric-value">@Currency.Format(TotalBalance)</div>
                <div class="metric-note">Available across your accounts</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-label">Total income</div>
                <div class="metric-value text-success">+@Currency.Format(TotalIncome)</div>
                <div class="metric-note">Money in this period</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-label">Total expenses</div>
                <div class="metric-value text-danger">-@Currency.Format(TotalExpenses)</div>
                <div class="metric-note">Money out this period</div>
            </div>
        </div>
</div>

<div class="row g-4 dashboard-panels">
        <div class="col-md-6">
            <div class="surface-panel h-100">
                <div class="panel-heading">
                    <div><p class="eyebrow mb-1">WHERE IT GOES</p><h2>Spending breakdown</h2></div>
                    <span class="panel-kicker">By category</span>
                </div>
                @if (Transactions.Any(t => t.Amount < 0))
                {
                    <div style="height: 190px;" class="mb-2">
                        <canvas id="spending-chart" aria-label="Spending by category chart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-state mb-3">Add a transaction to see your spending breakdown.</div>
                }
                @if (Categories != null && Categories.Any(c => c.Type == "Expense"))
                {
                    @foreach (var cat in Categories.Where(c => c.Type == "Expense"))
                    {
                        var spent = GetCategorySpent(cat.Id);
                        var pct = cat.MonthlyBudgetLimit > 0 ? Math.Min(100, (spent / cat.MonthlyBudgetLimit) * 100) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between text-sm mb-1">
                                <span class="fw-semibold">@cat.Name</span>
                                <span class="fw-bold">@Currency.Format(spent)</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @pct.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="surface-panel h-100">
                <div class="panel-heading">
                    <div><p class="eyebrow mb-1">MONTHLY GUARDRAILS</p><h2>Budget limits</h2></div>
                    <span class="panel-kicker">Live status</span>
                </div>
                @if (Categories != null && Categories.Any(c => c.Type == "Expense"))
                {
                    @foreach (var cat in Categories.Where(c => c.Type == "Expense"))
                    {
                        var spent = GetCategorySpent(cat.Id);
                        var limit = cat.MonthlyBudgetLimit;
                        var pct = limit > 0 ? Math.Min(100, (spent / limit) * 100) : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between text-sm mb-1">
                                <span class="fw-semibold">@cat.Name</span>
                                <span class="fw-bold">@Currency.Format(spent) / @Currency.Format(limit)</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @(pct >= 80 ? "bg-danger" : "bg-success")" role="progressbar" style="width: @pct.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

@code {
    private decimal TotalBalance;
    private decimal TotalIncome;
    private decimal TotalExpenses;

    private List<CategoryDto> Categories = new()
    {
        new CategoryDto { Id = 1, Name = "Groceries", Type = "Expense", MonthlyBudgetLimit = 500m },
        new CategoryDto { Id = 2, Name = "Utilities", Type = "Expense", MonthlyBudgetLimit = 200m },
        new CategoryDto { Id = 4, Name = "Entertainment", Type = "Expense", MonthlyBudgetLimit = 150m },
        new CategoryDto { Id = 5, Name = "Dining Out", Type = "Expense", MonthlyBudgetLimit = 300m }
    };

    private List<TransactionDto> Transactions = new();
    private bool chartRendered;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiCategories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
            if (apiCategories != null && apiCategories.Any())
            {
                Categories = apiCategories;
            }

            var apiTransactions = await Http.GetFromJsonAsync<List<TransactionDto>>("api/transactions");
            if (apiTransactions != null)
            {
                Transactions = apiTransactions;
                TotalIncome = Transactions.Where(t => t.Amount > 0).Sum(t => t.Amount);
                TotalExpenses = Transactions.Where(t => t.Amount < 0).Sum(t => Math.Abs(t.Amount));
                TotalBalance = TotalIncome - TotalExpenses;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load dashboard data: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartRendered || Categories.Count == 0 || !Transactions.Any(t => t.Amount < 0))
            return;

        var expenseCategories = Categories.Where(category => category.Type == "Expense").ToList();
        await JS.InvokeVoidAsync(
            "renderSpendingChart",
            "spending-chart",
            expenseCategories.Select(category => category.Name).ToArray(),
            expenseCategories.Select(category => (double)GetCategorySpent(category.Id)).ToArray());
        chartRendered = true;
    }

    private decimal GetCategorySpent(int categoryId)
    {
        return Transactions
            .Where(t => t.CategoryId == categoryId && t.Amount < 0)
            .Sum(t => Math.Abs(t.Amount));
    }

    public class CategoryDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal MonthlyBudgetLimit { get; set; }
    }

    public class TransactionDto
    {
        public int Id { get; set; }
        public string Description { get; set; } = "";
        public decimal Amount { get; set; }
        public int? CategoryId { get; set; }
    }
}
