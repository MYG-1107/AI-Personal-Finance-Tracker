@page "/forgot-password"
@using System.Net.Http.Json
@using AIPersonalFinanceTracker.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Reset password - AI Personal Finance Tracker</PageTitle>

<div class="auth-shell">
    <div class="auth-card surface-panel">
        <img class="auth-logo" src="logo.svg" alt="AI Personal Finance Tracker logo" />
        <p class="eyebrow">ACCOUNT RECOVERY</p>
        <h1>Reset your password</h1>
        <p class="text-muted">Request a secure reset code, then choose a new password.</p>
        @if (message is not null) { <div class="alert alert-info">@message</div> }
        @if (error is not null) { <div class="alert alert-danger">@error</div> }
        <label class="form-label" for="reset-email">Email</label>
        <input id="reset-email" class="form-control mb-3" type="email" @bind="email" autocomplete="email" />
        <button class="btn btn-primary w-100" @onclick="RequestCode" disabled="@busy">@(busy ? "Requesting..." : "Request reset code")</button>
        @if (token is not null)
        {
            <hr class="my-4" />
            <div class="alert alert-warning small">Development delivery: copy this reset code. In production, deliver it through your configured email provider.</div>
            <label class="form-label" for="reset-token">Reset code</label>
            <input id="reset-token" class="form-control mb-3" @bind="token" />
            <label class="form-label" for="new-password">New password</label>
            <input id="new-password" class="form-control mb-3" type="password" @bind="newPassword" autocomplete="new-password" />
            <button class="btn btn-success w-100" @onclick="ResetPassword" disabled="@busy">Set new password</button>
        }
        <p class="text-muted mt-4 mb-0"><a href="/login">Return to sign in</a></p>
    </div>
</div>

@code {
    private string email = "";
    private string? token;
    private string newPassword = "";
    private string? message;
    private string? error;
    private bool busy;

    private async Task RequestCode()
    {
        error = null;
        message = null;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/forgot-password", new ForgotPasswordRequest { Email = email });
            var payload = await response.Content.ReadFromJsonAsync<ResetResponse>();
            if (!response.IsSuccessStatusCode) { error = payload?.Message ?? "Unable to request a reset code."; return; }
            message = payload?.Message;
            token = payload?.ResetToken;
        }
        catch (Exception ex) { error = $"Unable to request a reset code: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task ResetPassword()
    {
        error = null;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/reset-password",
                new ResetPasswordRequest { Email = email, Token = token ?? "", NewPassword = newPassword });
            if (!response.IsSuccessStatusCode)
            {
                error = await response.Content.ReadAsStringAsync();
                return;
            }
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex) { error = $"Unable to reset password: {ex.Message}"; }
        finally { busy = false; }
    }

    private sealed class ResetResponse
    {
        public string? Message { get; set; }
        public string? ResetToken { get; set; }
    }
}
