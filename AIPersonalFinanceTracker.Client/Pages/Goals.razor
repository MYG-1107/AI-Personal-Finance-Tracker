@page "/goals"
@inject FinanceApiService Api
@inject CurrencyService Currency

<PageTitle>Savings Goals - Personal Finance Intelligence</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1">Savings Goals</h2><p class="text-muted mb-0">Turn your balance into measurable milestones.</p></div>
        <a href="/" class="btn btn-outline-primary">Dashboard</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info">@message</div> }
    <div class="card shadow-sm border-0 p-4 mb-4">
        <h5 class="fw-bold">Create a goal</h5>
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><label class="form-label">Goal name</label><input class="form-control" @bind="name" placeholder="Emergency fund" /></div>
            <div class="col-md-3"><label class="form-label">Target amount</label><input class="form-control" type="number" min="1" @bind="target" /></div>
            <div class="col-md-3"><label class="form-label">Already saved</label><input class="form-control" type="number" min="0" @bind="current" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" @onclick="CreateGoal">Add goal</button></div>
        </div>
    </div>
    <div class="row g-4">
        @foreach (var goal in goals)
        {
            var progress = goal.TargetAmount == 0 ? 0 : Math.Min(100, goal.CurrentAmount / goal.TargetAmount * 100);
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm border-0 p-4 h-100">
                    <div class="d-flex justify-content-between"><h5 class="fw-bold">@goal.Name</h5><span class="badge bg-success">@progress.ToString("N0")%</span></div>
                    <div class="progress my-3" style="height:14px"><div class="progress-bar bg-success" style="width:@($"{progress}%")"></div></div>
                    <div class="d-flex justify-content-between text-muted"><span>@Currency.Format(goal.CurrentAmount)</span><span>@Currency.Format(goal.TargetAmount)</span></div>
                    <div class="mt-3 small text-muted">Remaining: @Currency.Format(goal.TargetAmount - goal.CurrentAmount)</div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<SavingsGoal> goals = new();
    private string name = "";
    private decimal target;
    private decimal current;
    private string? message;

    protected override async Task OnInitializedAsync() => goals = await Api.GetGoalsAsync();

    private async Task CreateGoal()
    {
        var goal = await Api.CreateGoalAsync(new SavingsGoal { Name = name, TargetAmount = target, CurrentAmount = current });
        if (goal == null) { message = "Enter a valid name and amounts."; return; }
        goals.Add(goal);
        name = "";
        target = 0;
        current = 0;
        message = "Savings goal created.";
    }
}
