@page "/transactions"
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using AIPersonalFinanceTracker.Shared
@using AIPersonalFinanceTracker.Shared.Models
@inject HttpClient Http
@inject IJSRuntime JS
@inject CurrencyService Currency

<PageTitle>Transactions - AI Personal Finance Tracker</PageTitle>

<div class="page-intro">
    <div>
        <p class="eyebrow">LEDGER & AUTOMATION</p>
        <h1>Transactions</h1>
        <p class="page-subtitle">Capture spending quickly, then let AI keep your records organized.</p>
    </div>
    <a href="/" class="btn btn-outline-primary">← Overview</a>
</div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Transaction Entry Form -->
    <div class="surface-panel form-panel mb-4">
        <div class="panel-heading">
            <div><p class="eyebrow mb-1">QUICK CAPTURE</p><h2>Add a transaction</h2></div>
            <span class="panel-kicker">AI assisted</span>
        </div>
        <div class="input-group mb-3">
            <input class="form-control" @bind="smartText" placeholder="Smart Add: Spent 450 INR on groceries at Reliance Fresh yesterday" />
            <button class="btn btn-outline-primary" @onclick="ParseSmartAdd" disabled="@string.IsNullOrWhiteSpace(smartText)">🤖 Parse</button>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="receipt-upload">Receipt upload</label>
            <InputFile id="receipt-upload" OnChange="UploadReceipt" accept=".txt,.csv,.json,.xlsx,image/*,application/pdf" />
            <small class="text-muted d-block">Upload a receipt to pre-fill the form, or import CSV/XLSX transaction history.</small>
            <div class="mt-2">
                <InputFile id="history-upload" OnChange="ImportHistory" accept=".csv,.xlsx" />
            </div>
        </div>
        @if (smartPreview != null)
        {
            <div class="alert alert-info py-2">Parsed <strong>@smartPreview.Description</strong> as
                <strong>@smartPreview.Amount.ToString("N2") @smartPreview.CurrencyCode</strong>
                (@smartPreview.SuggestedCategoryName). Review the fields below and save.</div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="tx-description" class="form-label fw-semibold">Description</label>
                <input id="tx-description" type="text" class="form-control" @bind="newDescription" @bind:event="oninput" @onkeyup="PredictCategory" placeholder="e.g. Starbucks Coffee, Walmart Groceries, Uber" />
            </div>
            <div class="col-md-4">
                <div class="form-check recurring-control">
                <input id="recurring" class="form-check-input" type="checkbox" @bind="isRecurring" />
                <label class="form-check-label" for="recurring">Repeat monthly</label>
                @if (isRecurring)
                {
                    <input class="form-control recurring-day" type="number" min="1" max="31" @bind="recurrenceDay" aria-label="Day of month" />
                }
                </div>
            </div>
            <div class="col-md-2">
                <label for="tx-amount" class="form-label fw-semibold">Amount (@Currency.SelectedCode)</label>
                <input id="tx-amount" type="number" min="0.01" step="0.01" class="form-control" @bind="newAmount" placeholder="e.g. 45.00" />
            </div>
            <div class="col-md-2">
                <label for="tx-type" class="form-label fw-semibold">Type</label>
                <select id="tx-type" class="form-select" @bind="transactionType">
                    <option value="Expense">Expense</option>
                    <option value="Income">Income</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="tx-category" class="form-label fw-semibold">Category (ML Suggested)</label>
                <select id="tx-category" class="form-select" @bind="selectedCategoryId">
                    <option value="">Auto-Categorize via ML</option>
                    <option value="1">Groceries & Food</option>
                    <option value="2">Utilities & Bills</option>
                    <option value="3">Salary & Income</option>
                    <option value="4">Entertainment</option>
                    <option value="5">Transport & Travel</option>
                </select>
                @if (predictedCategoryId > 0)
                {
                    <small class="text-muted mt-1 d-block">
                        🤖 Predicted Category: <strong>@GetCategoryName(predictedCategoryId)</strong>
                    </small>
                }
                else if (!string.IsNullOrWhiteSpace(newDescription))
                {
                    <small class="text-warning mt-1 d-block">
                        ⚠️ No confident prediction. Please select a category.
                    </small>
                }
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-success px-4 fw-semibold" @onclick="SaveTransaction"
                    disabled="@(!CanSaveTransaction)">Add Transaction</button>
        </div>
    </div>

    <!-- Transaction History Table -->
    <div class="surface-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div><p class="eyebrow mb-1">YOUR LEDGER</p><h2 class="mb-0">Transaction history <span class="count-badge">@FilteredTransactions.Count()</span></h2></div>
            <button class="btn btn-outline-success btn-sm" @onclick="ExportCsv" disabled="@(transactions == null || !FilteredTransactions.Any())">
                Export CSV
            </button>
        </div>
        @if (transactions != null && transactions.Any())
        {
            <div class="row g-2 mb-3">
                <div class="col-md-5">
                    <input class="form-control" placeholder="Search descriptions..." @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterCategoryId">
                        <option value="0">All categories</option>
                        <option value="1">Groceries & Food</option>
                        <option value="2">Utilities & Bills</option>
                        <option value="3">Salary & Income</option>
                        <option value="4">Entertainment</option>
                        <option value="5">Transport & Travel</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" @bind="filterType">
                        <option value="All">All types</option>
                        <option value="Income">Income</option>
                        <option value="Expense">Expenses</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">Clear filters</button>
                </div>
            </div>
        }
        @if (transactions == null)
        {
            <p class="text-muted">Loading transactions...</p>
        }
        else if (!transactions.Any())
        {
            <p class="text-muted">No transactions recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Category</th>
                            <th>ML Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in FilteredTransactions)
                        {
                            <tr>
                                <td>@tx.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold">@tx.Description</td>
                                <td class="@(tx.Amount >= 0 ? "text-success" : "text-danger") fw-bold">
                                    @(tx.Amount >= 0 ? "+" : "-")@Currency.Format(tx.Amount)
                                </td>
                                <td><span class="badge bg-secondary">@GetCategoryName(tx.CategoryId)</span></td>
                                <td>
                                    @if (tx.IsAnomaly)
                                    {
                                        <span class="badge bg-warning text-dark" title="@tx.AnomalyReason">⚠️ Anomaly: @tx.AnomalyReason</span>
                                    }
                                    else if (tx.IsAutoCategorized)
                                    {
                                        <span class="badge bg-info text-dark">🤖 ML Categorized</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Needs Category</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" title="Delete transaction"
                                            @onclick="() => DeleteTransaction(tx.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

@code {
    private List<Transaction>? transactions;
    private string newDescription = "";
    private decimal newAmount = 0;
    private string transactionType = "Expense";
    private int? selectedCategoryId = null;
    private int predictedCategoryId = 0;
    private string? errorMessage;
    private string? successMessage;
    private string searchTerm = "";
    private int filterCategoryId;
    private string filterType = "All";
    private string smartText = "";
    private SmartAddPreview? smartPreview;
    private bool isRecurring;
    private int recurrenceDay = DateTime.UtcNow.Day;
    private DateTime transactionDate = DateTime.UtcNow;

    private IEnumerable<Transaction> FilteredTransactions =>
        (transactions ?? Enumerable.Empty<Transaction>())
            .Where(t => string.IsNullOrWhiteSpace(searchTerm) ||
                        t.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(t => filterCategoryId == 0 || t.CategoryId == filterCategoryId)
            .Where(t => filterType == "All" ||
                        (filterType == "Income" && t.Amount > 0) ||
                        (filterType == "Expense" && t.Amount < 0))
            .OrderByDescending(t => t.Date);

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        try
        {
            transactions = await Http.GetFromJsonAsync<List<Transaction>>("api/transactions");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load transactions: {ex.Message}";
        }
    }

    private async Task UploadReceipt(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        var file = args.File;
        if (file is null)
            return;

        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync("api/ocr/upload", content);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var scan = await response.Content.ReadFromJsonAsync<ReceiptScanResultDto>();
            if (scan is null)
                return;

            newDescription = scan.Description;
            newAmount = Math.Abs(scan.Amount);
            transactionType = "Expense";
            selectedCategoryId = scan.SuggestedCategoryId > 0 ? scan.SuggestedCategoryId : null;
            predictedCategoryId = scan.SuggestedCategoryId > 0 ? scan.SuggestedCategoryId : 0;
            transactionDate = scan.Date;
            successMessage = $"Receipt extracted from {scan.Merchant}. Review the fields before saving.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Receipt upload failed: {ex.Message}";
        }
    }

    private void PredictCategory()
    {
        if (string.IsNullOrWhiteSpace(newDescription))
        {
            predictedCategoryId = 0;
            return;
        }

        predictedCategoryId = TransactionCategoryClassifier.Predict(newDescription).CategoryId;
    }

    private async Task SaveTransaction()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(newDescription))
        {
            errorMessage = "Please enter a transaction description.";
            return;
        }

        if (newAmount == 0)
        {
            errorMessage = "Please enter a non-zero transaction amount.";
            return;
        }

        if (!selectedCategoryId.HasValue && predictedCategoryId == 0)
        {
            errorMessage = "Please select a category so this transaction is not misclassified.";
            return;
        }

        try
        {
            var payload = new
            {
                Description = newDescription,
                Amount = transactionType == "Expense" ? -Math.Abs(newAmount) : Math.Abs(newAmount),
                CategoryId = selectedCategoryId ?? predictedCategoryId,
                Date = transactionDate,
                IsRecurring = isRecurring,
                RecurrenceDay = isRecurring ? (int?)Math.Clamp(recurrenceDay, 1, 31) : null
            };

            var response = await Http.PostAsJsonAsync("api/transactions", payload);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<Transaction>();
                if (created != null)
                {
                    transactions ??= new List<Transaction>();
                    transactions.Add(created);
                }
                else
                {
                    await LoadTransactions();
                }

                successMessage = "Transaction added and processed successfully!";
                newDescription = "";
                newAmount = 0;
                transactionType = "Expense";
                selectedCategoryId = null;
                predictedCategoryId = 0;
                smartText = "";
                smartPreview = null;
                isRecurring = false;
                transactionDate = DateTime.UtcNow;
            }

            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Server returned error ({response.StatusCode}): {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving transaction: {ex.Message}";
        }
    }

    private async Task ParseSmartAdd()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/transactions/smart-add", new SmartAddRequest { Text = smartText });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            smartPreview = await response.Content.ReadFromJsonAsync<SmartAddPreview>();
            if (smartPreview != null)
            {
                newDescription = smartPreview.Description;
                newAmount = Math.Abs(smartPreview.Amount);
                transactionType = smartPreview.Amount >= 0 ? "Income" : "Expense";
                selectedCategoryId = smartPreview.SuggestedCategoryId;
                predictedCategoryId = smartPreview.SuggestedCategoryId ?? 0;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Smart Add failed: {ex.Message}";
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        filterCategoryId = 0;
        filterType = "All";
    }

    private async Task ImportHistory(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        successMessage = null;
        var file = args.File;
        if (file is null) return;

        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var streamContent = new StreamContent(stream);
            content.Add(streamContent, "file", file.Name);
            var response = await Http.PostAsync("api/transactions/import", content);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var imported = await response.Content.ReadFromJsonAsync<List<Transaction>>() ?? new();
            transactions ??= new List<Transaction>();
            transactions.AddRange(imported);
            successMessage = $"{imported.Count} transaction(s) imported. Categories were automatically predicted where possible.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Transaction history import failed: {ex.Message}";
        }
    }

    private async Task DeleteTransaction(int id)
    {
        var response = await Http.DeleteAsync($"api/transactions/{id}");
        if (response.IsSuccessStatusCode)
        {
            transactions?.RemoveAll(t => t.Id == id);
            successMessage = "Transaction deleted.";
        }
        else
        {
            errorMessage = $"Unable to delete transaction ({response.StatusCode}).";
        }
    }

    private async Task ExportCsv()
    {
        var rows = new List<string> { "Date,Description,Amount,Category,Type,AI Status" };
        rows.AddRange(FilteredTransactions.Select(t =>
            string.Join(",", Csv(t.Date.ToString("yyyy-MM-dd")), Csv(t.Description),
                t.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                Csv(GetCategoryName(t.CategoryId)), t.Amount >= 0 ? "Income" : "Expense",
                Csv(t.IsAutoCategorized ? "AI Categorized" : "Needs Review"))));
        await JS.InvokeVoidAsync("downloadFile", "transactions.csv", string.Join("\n", rows));
    }

    private static string Csv(string value) => $"\"{value.Replace("\"", "\"\"")}\"";

    private bool CanSaveTransaction =>
        !string.IsNullOrWhiteSpace(newDescription) &&
        newAmount != 0 &&
        (selectedCategoryId.HasValue || predictedCategoryId > 0);

    private string GetCategoryName(int? catId) => catId switch
    {
        1 => "Groceries & Food",
        2 => "Utilities & Bills",
        3 => "Salary & Income",
        4 => "Entertainment",
        5 => "Transport & Travel",
        _ => "Uncategorized"
    };
}
