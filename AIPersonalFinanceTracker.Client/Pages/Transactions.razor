@page "/transactions"
@using AIPersonalFinanceTracker.Shared.Models
@using AIPersonalFinanceTracker.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject FinanceApiService ApiService
@inject IJSRuntime JS

<PageTitle>Transactions - AI Personal Finance Tracker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Transactions Management</h2>
    <div class="d-flex gap-2">
        <label class="btn btn-outline-success mb-0">
            Import CSV
            <InputFile OnChange="HandleCsvUpload" accept=".csv" class="d-none" />
        </label>
        <button class="btn btn-outline-secondary" @onclick="ExportCsv">Export CSV</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<!-- Add New Transaction Form -->
<div class="card border-0 shadow-sm p-4 mb-4">
    <h5 class="mb-3">Add New Transaction</h5>
    <EditForm Model="@newTransaction" OnValidSubmit="HandleAddTransaction">
        <DataAnnotationsValidator />
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold">Description</label>
                <InputText class="form-control" placeholder="e.g. Starbucks Coffee" @bind-Value="newTransaction.Description" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Amount ($)</label>
                <InputNumber class="form-control" @bind-Value="newTransaction.Amount" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Category</label>
                <InputSelect class="form-select" @bind-Value="selectedCategoryId">
                    <option value="0">-- Select Category --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name (@cat.Type)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary px-4" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Adding...</span>
                    }
                    else
                    {
                        <span>Add</span>
                    }
                </button>
            </div>
        </div>
    </EditForm>
</div>

<!-- Recent Transactions Table -->
<div class="card border-0 shadow-sm p-4">
    <h5 class="mb-3">Recent Transactions</h5>
    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading transactions...</span>
            </div>
        </div>
    }
    else if (!transactions.Any())
    {
        <p class="text-muted">No transactions recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>AI Auto-Categorized</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in transactions)
                    {
                        var isIncome = item.Category?.Type == "Income";
                        var amountColor = isIncome ? "text-success" : "text-danger";
                        var amountPrefix = isIncome ? "+" : "-";

                        <tr>
                            <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-semibold">@item.Description</td>
                            <td class="@amountColor fw-bold">@amountPrefix$@item.Amount.ToString("F2")</td>
                            <td>
                                <span class="badge bg-secondary">@(item.Category?.Name ?? "Uncategorized")</span>
                            </td>
                            <td>
                                @if (item.IsAutoCategorized)
                                {
                                    <span class="badge bg-success">Auto</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Transaction> transactions = new();
    private List<Category> categories = new();
    private Transaction newTransaction = new() { Date = DateTime.UtcNow };
    private int selectedCategoryId = 0;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? statusMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = await ApiService.GetCategoriesAsync();
            transactions = await ApiService.GetTransactionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleAddTransaction()
    {
        if (string.IsNullOrWhiteSpace(newTransaction.Description)) return;

        isSubmitting = true;
        try
        {
            if (selectedCategoryId > 0)
            {
                newTransaction.CategoryId = selectedCategoryId;
            }

            newTransaction.Date = DateTime.UtcNow;

            await ApiService.CreateTransactionAsync(newTransaction);
            statusMessage = "Transaction added successfully!";
            newTransaction = new() { Date = DateTime.UtcNow };
            selectedCategoryId = 0;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding transaction: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleCsvUpload(InputFileChangeEventArgs e)
    {
        statusMessage = null;
        errorMessage = null;

        try
        {
            var file = e.File;
            if (file == null) return;

            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var reader = new StreamReader(ms);
            var csvText = await reader.ReadToEndAsync();

            var lines = csvText.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1)
            {
                errorMessage = "CSV file is empty or missing data rows.";
                return;
            }

            int importedCount = 0;
            for (int i = 1; i < lines.Length; i++)
            {
                var parts = lines[i].Split(',');
                if (parts.Length >= 2)
                {
                    var desc = parts[0].Trim().Trim('"');
                    var amountStr = parts[1].Trim().Trim('"');

                    if (decimal.TryParse(amountStr, out var amount) && !string.IsNullOrWhiteSpace(desc))
                    {
                        var t = new Transaction
                        {
                            Description = desc,
                            Amount = amount,
                            Date = DateTime.UtcNow
                        };
                        await ApiService.CreateTransactionAsync(t);
                        importedCount++;
                    }
                }
            }

            statusMessage = $"Successfully imported {importedCount} transactions!";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error importing CSV: {ex.Message}";
        }
    }

    private async Task ExportCsv()
    {
        if (!transactions.Any())
        {
            errorMessage = "No transactions available to export.";
            return;
        }

        var builder = new System.Text.StringBuilder();
        builder.AppendLine("Description,Amount");

        foreach (var t in transactions)
        {
            builder.AppendLine($"\"{t.Description.Replace("\"", "\"\"")}\",{t.Amount}");
        }

        var fileName = $"transactions_export_{DateTime.UtcNow:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("financeHelpers.downloadFile", fileName, builder.ToString());
        statusMessage = $"Exported {transactions.Count} transactions to {fileName}";
    }
}
