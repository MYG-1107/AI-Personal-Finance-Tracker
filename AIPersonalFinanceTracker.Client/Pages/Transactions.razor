@page "/transactions"
@using System.IO
@using System.Text
@using AIPersonalFinanceTracker.Shared.Models
@using AIPersonalFinanceTracker.Client.Services
@inject FinanceApiService ApiService
@inject IJSRuntime JS

<PageTitle>Transactions - AI Personal Finance Tracker</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Transactions Management</h3>
    <div class="d-flex gap-2">
        <label class="btn btn-outline-success btn-sm mb-0">
            <i class="bi bi-file-earmark-arrow-up"></i> Import CSV
            <InputFile OnChange="HandleCsvUpload" accept=".csv" class="d-none" />
        </label>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportToCsv" disabled="@(!transactions.Any())">
            <i class="bi bi-file-earmark-arrow-down"></i> Export CSV
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
    </div>
}

<div class="card mb-4 p-3 shadow-sm">
    <h5>Add New Transaction</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Description</label>
            <input class="form-control" @bind="newTransaction.Description" @bind:event="oninput" @onblur="AutoPredictCategory" placeholder="e.g. Starbucks Coffee" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Amount ($)</label>
            <input type="number" step="0.01" class="form-control" @bind="newTransaction.Amount" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select class="form-select" @bind="newTransaction.CategoryId">
                <option value="0">-- Select Category --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Name (@cat.Type)</option>
                }
            </select>
            @if (!string.IsNullOrEmpty(predictedCategoryName))
            {
                <small class="text-success fw-bold d-block mt-1">AI Suggested: @predictedCategoryName</small>
            }
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="SaveTransaction">Add</button>
        </div>
    </div>
</div>

<h5>Recent Transactions</h5>
@if (transactions == null)
{
    <p><em>Loading transactions...</em></p>
}
else if (!transactions.Any())
{
    <p>No transactions recorded yet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Category</th>
                <th>AI Auto-Categorized</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in transactions)
            {
                <tr>
                    <td>@item.Date.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.Description</td>
                    <td class="@(item.Category?.Type == "Income" ? "text-success fw-bold" : "text-danger fw-bold")">
                        @(item.Category?.Type == "Income" ? "+" : "-")$@item.Amount.ToString("F2")
                    </td>
                    <td><span class="badge bg-secondary">@(item.Category?.Name ?? "Uncategorized")</span></td>
                    <td>
                        @if (item.IsAutoCategorized)
                        {
                            <span class="badge bg-success">Auto</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">Manual</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Transaction> transactions = new();
    private List<Category> categories = new();
    private Transaction newTransaction = new();
    private string predictedCategoryName = string.Empty;
    private string statusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            categories = await ApiService.GetCategoriesAsync();
            transactions = await ApiService.GetTransactionsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = "Error loading data: " + ex.Message;
        }
    }

    private async Task AutoPredictCategory()
    {
        if (!string.IsNullOrWhiteSpace(newTransaction.Description))
        {
            try
            {
                predictedCategoryName = await ApiService.PredictCategoryAsync(newTransaction.Description);
                var matchedCategory = categories.FirstOrDefault(c => c.Name.Equals(predictedCategoryName, StringComparison.OrdinalIgnoreCase));
                if (matchedCategory != null)
                {
                    newTransaction.CategoryId = matchedCategory.Id;
                    newTransaction.IsAutoCategorized = true;
                }
            }
            catch
            {
                // Silent fallback
            }
        }
    }

    private async Task SaveTransaction()
    {
        if (newTransaction.CategoryId > 0 && newTransaction.Amount > 0)
        {
            try
            {
                await ApiService.CreateTransactionAsync(newTransaction);
                newTransaction = new Transaction();
                predictedCategoryName = string.Empty;
                statusMessage = "Transaction added successfully!";
                await LoadData();
            }
            catch (Exception ex)
            {
                statusMessage = "Failed to save transaction: " + ex.Message;
            }
        }
    }

    private async Task ExportToCsv()
    {
        var builder = new StringBuilder();
        builder.AppendLine("Date,Description,Amount,Category,Type,IsAutoCategorized");

        foreach (var t in transactions)
        {
            builder.AppendLine($"\"{t.Date:yyyy-MM-dd HH:mm}\",\"{t.Description}\",{t.Amount},\"{t.Category?.Name}\",\"{t.Category?.Type}\",{t.IsAutoCategorized}");
        }

        var fileName = $"transactions_export_{DateTime.Now:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("financeHelpers.downloadFile", fileName, builder.ToString());
        statusMessage = $"Exported {transactions.Count} transactions to {fileName}";
    }

    private async Task HandleCsvUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var reader = new StreamReader(stream);

            var newTransactions = new List<Transaction>();
            string? headerLine = await reader.ReadLineAsync();

            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var parts = line.Split(',');
                if (parts.Length >= 2)
                {
                    var description = parts[0].Trim('"').Trim();
                    if (decimal.TryParse(parts[1].Trim(), out decimal amount))
                    {
                        var predictedCategory = await ApiService.PredictCategoryAsync(description);
                        var category = categories.FirstOrDefault(c => c.Name.Equals(predictedCategory, StringComparison.OrdinalIgnoreCase))
                                       ?? categories.FirstOrDefault();

                        newTransactions.Add(new Transaction
                        {
                            Description = description,
                            Amount = amount,
                            CategoryId = category?.Id ?? 1,
                            IsAutoCategorized = true,
                            Date = DateTime.UtcNow
                        });
                    }
                }
            }

            if (newTransactions.Any())
            {
                await ApiService.CreateBulkTransactionsAsync(newTransactions);
                statusMessage = $"Successfully imported {newTransactions.Count} transactions with AI auto-categorization!";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Error importing CSV: " + ex.Message;
        }
    }
}
